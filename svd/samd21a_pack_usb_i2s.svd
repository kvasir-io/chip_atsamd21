                        <enumeratedValue>
                           <name>16</name>
                           <description>16-bit Slot for Clock Unit n</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>24</name>
                           <description>24-bit Slot for Clock Unit n</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32</name>
                           <description>32-bit Slot for Clock Unit n</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NBSLOTS</name>
