                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FSPIN</name>
                           <description>FSn input pin is used as Frame Sync n source</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
